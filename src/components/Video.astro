---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: string;
	poster: ImageMetadata;
	label: string;
	caption?: string;
}

const { src, poster, label, caption } = Astro.props;
const posterImg = await getImage({ src: poster, width: 960, format: 'webp' });
---

<figure>
	<video
		src={src}
		poster={posterImg.src}
		width={poster.width}
		height={poster.height}
		aria-label={label}
		autoplay
		loop
		muted
		playsinline
		preload="metadata"
	></video>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	figure {
		margin: 1.75em 0;
		text-align: center;
	}
	video {
		display: block;
		margin: 0 auto;
		max-width: 100%;
		max-height: 340px;
		width: auto;
		height: auto;
	}
	figcaption {
		margin-top: 0.6em;
		font-size: 0.82em;
		color: var(--text-secondary);
		line-height: 1.45;
		font-style: italic;
		opacity: 0.7;
	}
</style>
