---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	images: { src: ImageMetadata; alt: string }[];
	caption?: string;
}

const { images, caption } = Astro.props;
---

<figure class="gallery">
	<div class="row">
		{images.map(({ src, alt }) => (
			<a href={src.src} class="lightbox-trigger" data-lightbox>
				<Image src={src} alt={alt} width={480} densities={[1, 2]} />
			</a>
		))}
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.gallery {
		margin: 2rem 0;
	}
	.row {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
	}
	.lightbox-trigger {
		display: block;
		cursor: zoom-in;
		border: none;
	}
	.lightbox-trigger :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	figcaption {
		margin-top: 0.6em;
		font-size: 0.82em;
		color: var(--text-secondary);
		text-align: center;
		line-height: 1.45;
		font-style: italic;
		opacity: 0.7;
	}
	/* On phones, swipe through them instead of squeezing three across. */
	@media (max-width: 600px) {
		.row {
			grid-template-columns: none;
			grid-auto-flow: column;
			grid-auto-columns: 78%;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scrollbar-width: none;
		}
		.row::-webkit-scrollbar { display: none; }
		.lightbox-trigger { scroll-snap-align: start; }
	}
</style>
