---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import { BLOG_DESCRIPTION, BLOG_TITLE } from '../../consts';
import { ogImageFor } from '../../utils/og';

const ogImage = await ogImageFor();

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Derived from the collection so new categories show up in the filter bar.
const categories = [...new Set(posts.map((p) => p.data.category).filter(Boolean))]
	.map((name) => ({
		name: name as string,
		count: posts.filter((p) => p.data.category === name).length,
	}))
	.sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={BLOG_TITLE} description={BLOG_DESCRIPTION} image={ogImage} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Posts</h1>
			<div class="filters" id="filters" role="group" aria-label="Filter posts by category">
				<button class="filter active" data-filter="all" aria-pressed="true">
					All <span class="count">{posts.length}</span>
				</button>
				{categories.map((c) => (
					<button class="filter" data-filter={c.name} aria-pressed="false">
						{c.name} <span class="count">{c.count}</span>
					</button>
				))}
			</div>
			<section>
				{posts.length === 0 && <p class="empty">Nothing here yet.</p>}
				<p class="empty" id="no-matches" hidden>No posts in this category yet.</p>
				<div class="post-list">
					{posts.map((post) => <PostCard post={post} />)}
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const filters = document.querySelectorAll<HTMLButtonElement>('.filter');
			const cards = document.querySelectorAll<HTMLElement>('.card');
			const noMatches = document.getElementById('no-matches');

			const known = new Set(Array.from(filters, (b) => b.dataset.filter));

			function apply(category: string) {
				let shown = 0;
				cards.forEach((card) => {
					const match = category === 'all' || card.dataset.category === category;
					card.hidden = !match;
					if (match) shown++;
				});

				filters.forEach((b) => {
					const active = b.dataset.filter === category;
					b.classList.toggle('active', active);
					// Screen readers get the state, not just the colour change.
					b.setAttribute('aria-pressed', String(active));
				});

				if (noMatches) noMatches.hidden = shown > 0;
			}

			// ?category=Books makes a filtered view linkable and shareable.
			function fromURL(): string {
				const value = new URLSearchParams(location.search).get('category');
				return value && known.has(value) ? value : 'all';
			}

			filters.forEach((btn) => {
				btn.addEventListener('click', () => {
					const category = btn.dataset.filter ?? 'all';
					apply(category);
					const url = new URL(location.href);
					if (category === 'all') url.searchParams.delete('category');
					else url.searchParams.set('category', category);
					// pushState so the back button steps through filters.
					history.pushState({ category }, '', url);
				});
			});

			window.addEventListener('popstate', () => apply(fromURL()));
			apply(fromURL());
		</script>
	</body>
</html>

<style>
	h1 { margin-bottom: 1.5rem; }
	.filters {
		display: flex;
		flex-wrap: wrap;
		margin-bottom: 1.25rem;
	}
	.filters > * { margin-right: 0.5rem; margin-bottom: 0.5rem; }
	.filter {
		padding: 0.35rem 0.85rem;
		border-radius: 0;
		border: 1px solid var(--border);
		background: none;
		color: var(--text-secondary);
		font-size: 0.82rem;
		font-family: inherit;
		cursor: pointer;
		transition: background 0.15s, color 0.15s, border-color 0.15s;
	}
	.filter:hover { color: var(--text); border-color: var(--text-secondary); }
	.filter.active { background: var(--text); color: var(--bg); border-color: var(--text); }
	.filter .count {
		font-variant-numeric: tabular-nums;
		opacity: 0.55;
		margin-left: 0.15rem;
		font-size: 0.94em;
	}
	.post-list {
		display: flex;
		flex-direction: column;
		/* gap, not "> * + *": Astro scopes sibling selectors to the page
		   hash, which no longer matches PostCard-scoped children. */
		gap: 1rem;
	}
	.empty {
		color: var(--text-secondary);
		padding: 2rem 0;
	}

</style>
