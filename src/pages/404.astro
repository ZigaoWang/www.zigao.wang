---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE } from '../consts';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Page not found | ${SITE_TITLE}`} description="That page doesn't exist." />
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<Header />
		<main>
			<header class="head">
				<p class="code">404</p>
				<h1>This page doesn't exist.</h1>
				<p class="lead">The link may be broken, or the page may have moved. Try one of these instead:</p>
			</header>

			<div class="post-list">
				{recentPosts.map((post) => <PostCard post={post} />)}
			</div>

			<div class="actions">
				<a href="/" class="action">Back home <span aria-hidden="true">&rarr;</span></a>
				<a href="/blog" class="action secondary">All posts</a>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main { padding-top: 3.5rem; padding-bottom: 4.5rem; }

	.head {
		margin-bottom: 2rem;
		padding-bottom: 1.75rem;
		border-bottom: 1px solid var(--border);
	}
	.code {
		font-family: var(--font-hand);
		font-size: 5.5rem;
		line-height: 0.95;
		color: var(--text);
		margin: 0 0 0.9rem;
	}
	.head h1 {
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: 2rem;
		letter-spacing: -0.02em;
		margin: 0 0 0.45rem;
	}
	.lead {
		color: var(--text-secondary);
		font-size: 1rem;
		line-height: 1.65;
		margin: 0;
	}

	.post-list {
		display: flex;
		flex-direction: column;
		/* gap, not "> * + *": Astro scopes sibling selectors to the page
		   hash, which no longer matches PostCard-scoped children. */
		gap: 1rem;
	}

	.actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.6rem 1.5rem;
		margin-top: 2.25rem;
	}
	.action {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.75rem 1.75rem;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--text);
		background: var(--surface);
		border: 1px solid #2a2a2a;
		text-decoration: none;
		transition: background 0.15s, border-color 0.15s;
	}
	.action:hover {
		background: var(--surface-hover);
		border-color: var(--text-secondary);
	}
	.action.secondary {
		background: none;
		border-color: transparent;
		padding-left: 0;
		padding-right: 0;
		color: var(--text-secondary);
	}
	.action.secondary:hover {
		background: none;
		border-color: transparent;
		color: var(--text);
	}

	@media (max-width: 600px) {
		main { padding-top: 2.5rem; }
		.code { font-size: 4rem; }
		.head h1 { font-size: 1.6rem; }
	}

</style>
